# Provedor de extracao: "anthropic", "mock" ou "edge" (Edge Function do Supabase).
# Sem ANTHROPIC_API_KEY o provedor cai para "mock".
EXTRACT_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Abaixo deste valor (0 a 1) o pedido vai para a fila de revisao.
CONFIDENCE_THRESHOLD=0.8
# Lanca direto no Bling quando a confianca passa do limiar.
AUTO_LANCAR=true
# Processa os exemplos ao subir (so no armazenamento em memoria).
SEED_DEMO=true

# Armazenamento: "memory" (demo) ou "supabase".
STORAGE=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Usada pelo app para chamar a Edge Function quando EXTRACT_PROVIDER=edge.
SUPABASE_ANON_KEY=

# Bling: "sandbox" registra o payload sem enviar; "live" chama a API v3.
BLING_MODE=sandbox
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=
